# Local : copier en .env (ne jamais committer)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
FINNHUB_API_KEY=your-finnhub-key
